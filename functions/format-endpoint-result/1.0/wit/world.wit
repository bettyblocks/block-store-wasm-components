package betty-blocks:format-endpoint-result@2.0.0;

interface format-endpoint-result {
    use betty-blocks-types:types/types@3.2.0.{betty-map, betty-value, json-string};

    // This returns a json-string because the regular return type uses a list of tuples, which is unsupported
    format-endpoint-result: func(status-code: u16, body: betty-value, headers: betty-map) -> result<json-string, string>;
}

world main {
    export format-endpoint-result;
}
