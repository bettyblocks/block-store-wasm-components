package betty-blocks:format-endpoint-result@1.0.0;

interface format-endpoint-result {
    type json-string = string;

    // The body and header values are json strings because they have unknown types
    record header {
        key: string,
        value: json-string
    }

    // This returns a json-string because the regular return type uses a list of tuples, which is unsupported
    format-endpoint-result: func(status-code: u16, body: json-string, headers: list<header>) -> result<json-string, string>;
}

world main {
    export format-endpoint-result;
}
    