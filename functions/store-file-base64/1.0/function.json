{
  "description": "Uploads a file to the asset store and returns a reference which can be used in a create or update",
  "label": "Store File Base64",
  "category": "Misc",
  "icon": {
    "name": "UploadIcon",
    "color": "Orange"
  },
  "options": [
    {
      "meta": {
        "type": "Model",
        "validations": {
          "required": true
        }
      },
      "name": "model",
      "label": "Model"
    },
    {
      "meta": {
        "allowedKinds": ["FILE", "IMAGE"],
        "type": "Property",
        "model": "model",
        "validations": {
          "required": true
        }
      },
      "configuration": {
        "dependsOn": [
          {
            "option": "model",
            "action": "CLEAR"
          }
        ]
      },
      "name": "property",
      "label": "Property"
    },
    {
      "meta": {
        "type": "Text",
        "validations": {
          "required": true
        }
      },
      "name": "data",
      "label": "Base64 Data"
    },
    {
      "meta": {
        "type": "Text",
        "validations": {
          "required": true
        }
      },
      "name": "filename",
      "label": "Filename"
    },
    {
      "meta": {
        "type": "Text",
        "validations": {
          "required": true
        }
      },
      "name": "file_extension",
      "label": "File extension",
      "info": "The extension of the file is for example JPG. You can use both .jpg or JPG to specify the file extension. Do not use .JPG, as this will make the file extension capitalized." },
    {
      "meta": {
        "type": "Output",
        "output": {
          "type": "Text"
        }
      },
      "name": "reference",
      "label": "File reference",
      "info": "Used to refer to a stored file"
    }
  ],
  "yields": "NONE"
}
